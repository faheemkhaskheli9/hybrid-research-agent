{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ingest docs (CLI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/ingest_docs.py",
            "args": ["--config", "configs/default.yaml"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
